#include <stdio.h>

struct rectangle {
    float length;
    float width;
};

int main() {
    struct rectangle r;
    float area, perimeter;

    printf("Enter length: ");
    scanf("%f", &r.length);

    printf("Enter width: ");
    scanf("%f", &r.width);

    area = r.length * r.width;
    perimeter = 2 * (r.length + r.width);

    printf("\nRectangle Details\n");
    printf("Length: %.2f\n", r.length);
    printf("Width: %.2f\n", r.width);
    printf("Area: %.2f\n", area);
    printf("Perimeter: %.2f\n", perimeter);

    return 0;
}
