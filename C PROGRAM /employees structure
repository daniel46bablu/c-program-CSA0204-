#include <stdio.h>

struct employee {
    int id;
    char name[50];
    float salary;
};

int main() {
    struct employee e[3] = {
        {101, "John", 25000},
        {102, "David", 30000},
        {103, "Smith", 28000}
    };

    printf("Employee Details\n");

    for (int i = 0; i < 3; i++) {
        printf("\nEmployee %d\n", i + 1);
        printf("ID: %d\n", e[i].id);
        printf("Name: %s\n", e[i].name);
        printf("Salary: %.2f\n", e[i].salary);
    }

    return 0;
}
