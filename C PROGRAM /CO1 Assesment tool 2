#include <stdio.h>

int main() {
    int num, original, digit, sum = 0;

    printf("Enter a 3-digit number: ");
    scanf("%d", &num);

    original = num;

    do {
        digit = num % 10;
        sum = sum + (digit * digit * digit);
        num = num / 10;
    } while (num != 0);

    if (sum == original) {
        printf("%d is an Armstrong number\n", original);
    }
    else {
        printf("%d is not an Armstrong number\n", original);
    }

    return 0;
}



